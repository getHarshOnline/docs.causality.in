  "paths": {
    "/api/episodes": {
      "get": {
        "description": "List all episodes with summary statistics.",
        "operationId": "list_episodes_api_episodes_get",
        "parameters": [
          {
            "description": "Maximum episodes to return",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Maximum episodes to return",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EpisodeSummary"
                  },
                  "title": "Response List Episodes Api Episodes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Episodes",
        "tags": [
          "events"
        ]
      }
    },
